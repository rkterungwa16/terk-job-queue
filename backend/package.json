{
  "name": "jobqueue-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reminders job queue engine (TypeScript) — MongoDB-backed, polling job processor with admin API.",
  "scripts": {
    "dev": "tsx watch src/infrastructure/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/infrastructure/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8",
    "mailgun.js": "^10.2.3",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "typescript": "^5.5.3",
    "tsx": "^4.16.2"
  },
  "engines": {
    "node": ">=18"
  }
}
